# stackchan-mcp configuration
# Copy this file to .env and fill in your values.

# --- Network ---
STACKCHAN_IP=192.168.1.200
STACKCHAN_PORT=80
MAC_IP=192.168.1.100
AUDIO_SERVE_PORT=5060

# --- TTS Engine ---
# Options: "edge-tts" (free, no API key), "minimax", "fish-audio"
TTS_ENGINE=edge-tts

# --- MiniMax T2A v2 (optional) ---
MINIMAX_API_BASE=https://api.minimaxi.com
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_MODEL=speech-02-hd
MINIMAX_VOICE_ZH=
MINIMAX_VOICE_EN=
MINIMAX_SPEED=1.0

# --- Fish Audio (optional) ---
FISH_AUDIO_KEY=

# --- STT (faster-whisper, local) ---
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
